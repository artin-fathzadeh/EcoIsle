# ⚠️ CRITICAL: AI MODEL CONFIGURATION - DO NOT CHANGE
# EcoIsle uses x-ai/grok-4-fast:free for ALL AI functions
# This is the ONLY approved AI model for this application

# OpenRouter API Key (required for AI features)
OPENROUTER_API_KEY=your_openrouter_api_key_here

# ⚠️ CRITICAL: AI_MODEL must ALWAYS be 'x-ai/grok-4-fast:free' - DO NOT CHANGE
# This environment variable is NOT used anymore - the model is hardcoded
# AI_MODEL=x-ai/grok-4-fast:free

# HTTP Referer for OpenRouter API (optional)
HTTP_REFERER=http://localhost:5000

# Test mode (set to 'true' to use simulated AI responses without API key)
AI_TEST_MODE=false

# ==============================================
# CESIUM 3D GLOBE CONFIGURATION
# ==============================================

# Cesium Ion Access Token (optional - has default for development)
# Get your token from: https://ion.cesium.com/tokens
VITE_CESIUM_TOKEN=your_cesium_ion_token_here

# Map Engine Selection
# Options: 'cesium' (new 3D globe) | 'threejs' (original Three.js map)
VITE_MAP_ENGINE=cesium
